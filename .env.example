DATABASE_URL="file:./dev.db"
# Optional: enables live text/vision analysis and embedding similarity.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Optional sandbox read access. No live payment or bank mutations are implemented.
RAMP_ACCESS_TOKEN=""
RAMP_ENVIRONMENT="sandbox"
# Local demo only. Set a token to require Bearer auth for all API access.
APP_ACCESS_TOKEN=""

# Optional Claude analysis. Claude takes priority when both keys are set.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Optional standalone voice media bridge
TWILIO_AUTH_TOKEN=""
VOICE_PUBLIC_ORIGIN=""
OPENAI_REALTIME_MODEL="gpt-realtime-1.5"

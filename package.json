    "@tailwindcss/postcss": "^4.1.0"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",

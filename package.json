{
  "name": "bank-change-guard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "fixtures": "tsx scripts/export-fixtures.ts",
    "vendor:add": "tsx scripts/setup-vendor.ts",
    "format": "prettier --write src prisma tests scripts docs/*.md README.md next.config.ts tsconfig.json",
    "demo:reset": "tsx scripts/reset-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4.1.0",
    "dotenv": "^18.0.10",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.0",
    "next": "16.4.6",
    "openai": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
